# Copy to cloudflare/.dev.vars (for `cf dev`) or cloudflare/.env.cloudflare (for `setup.sh` / `cf deploy --secrets-file`)

# Required: Managed PostgreSQL (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/postiz?sslmode=require"

# Required: Generate with `openssl rand -base64 32`
JWT_SECRET="replace-with-random-secret"
CLOUDFLARE_INTERNAL_SECRET="replace-with-random-internal-secret"

# Required: Cloudflare R2 (S3 API credentials for presigned uploads + public URL with NO trailing slash)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_ACCESS_KEY="your-r2-s3-access-key-id"
CLOUDFLARE_SECRET_ACCESS_KEY="your-r2-s3-secret-access-key"
CLOUDFLARE_BUCKETNAME="postiz-media"
# Point to either your Worker's built-in `/uploads` proxy OR a custom R2 public domain (NO trailing slash):
CLOUDFLARE_BUCKET_URL="https://postiz.your-domain.com/uploads"

# Recommended: Explicitly set your deployed domain (falls back to incoming Worker origin if omitted)
MAIN_URL="https://postiz.your-domain.com"
FRONTEND_URL="https://postiz.your-domain.com"
NEXT_PUBLIC_BACKEND_URL="https://postiz.your-domain.com/api"

# Optional: Channel token encryption (`openssl rand -base64 32`)
# ENCRYPTION_PROVIDER="local"
# ENCRYPTION_KEY=""

# Optional: Transactional emails & AI
# EMAIL_PROVIDER="resend"
# EMAIL_FROM_ADDRESS="noreply@your-domain.com"
# EMAIL_FROM_NAME="Postiz"
# RESEND_API_KEY=""
# OPENAI_API_KEY=""

# Optional: Bundle any social OAuth credentials (X_API_KEY, LINKEDIN_CLIENT_ID, etc.) as JSON
# POSTIZ_EXTRA_ENV_JSON='{"X_API_KEY":"","X_API_SECRET":""}'
